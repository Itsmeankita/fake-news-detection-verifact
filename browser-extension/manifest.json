{
  "manifest_version": 3,
  "name": "VeriFact — Fake News Detector",
  "version": "1.0",
  "description": "Select any news text on a webpage and check it with your VeriFact model.",
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:5000/*", "http://localhost:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VeriFact — Check selected text"
  },
  "icons": {
    "48": "icons/icon48.png"
  }
}
