# Copy this file to ".env" and fill in real values.
# .env is gitignored — never commit real secrets.

# Used to sign session cookies. Change this to any random string.
SECRET_KEY=change-this-to-something-random

# Optional — enables the fact-check cross-referencing feature on Detect.
# Get a free key at https://console.cloud.google.com/ (enable "Fact Check Tools API").
FACTCHECK_API_KEY=
